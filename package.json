{
  "name": "luanode-vm",
  "version": "1.0.0",
  "description": "High-performance Lua 5.3 Virtual Machine and runtime implemented in modern JavaScript (ES6+), engineered for seamless execution across Node.js and browser environments.",
  "main": "src/luanode.js",
  "module": "src/luanode.js",
  "type": "commonjs",
  "bin": {
    "luanode": "cli/luanode.js"
  },
  "directories": {
    "lib": "src",
    "test": "tests"
  },
  "scripts": {
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ tests/ cli/",
    "lint:fix": "eslint --fix src/ tests/ cli/",
    "cli": "node cli/luanode.js",
    "benchmark": "node cli/luanode.js bench/runtime.lua",
    "smoke": "node cli/luanode.js -e \"print('LuaNode-VM OK'); print(math.maxinteger); print(math.maxinteger + 1)\""
  },
  "keywords": [
    "lua",
    "lua53",
    "virtual-machine",
    "vm",
    "javascript",
    "es6",
    "runtime",
    "browser-lua",
    "node-lua",
    "bigint",
    "64-bit-integer"
  ],
  "author": "Xyraniz",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jest": "^29.0.0"
  },
  "dependencies": {
    "readline-sync": "^1.4.10",
    "sprintf-js": "^1.1.3",
    "tmp": "^0.2.5"
  },
  "sideEffects": false
}
